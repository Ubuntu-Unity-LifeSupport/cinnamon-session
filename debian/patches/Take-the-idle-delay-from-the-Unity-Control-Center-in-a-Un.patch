From: NeiroNext <mihail.rozshko@gmail.com>
Date: Tue, 13 Oct 2026 14:15:09 +0000
Subject: Take the idle delay from the Unity Control Center in a Unity session

The presence went idle after org.cinnamon.desktop.session idle-delay
(default 900 s) also in the Unity session, where the Control Center sets
org.gnome.desktop.session idle-delay (default 300 s) and nothing changes
the Cinnamon key.

The binding of the presence's idle timeout is now made once, after the
session file has set XDG_CURRENT_DESKTOP: when that includes Unity and
org.gnome.desktop.session has an unsigned idle-delay key, the presence
follows it, live as before; otherwise the Cinnamon key as before. 0 still
means never.

Until the binding is made the presence keeps its construct default of
300 s; no idle watch reaches the idle monitor before then. The existing
seconds-to-milliseconds mapping is unchanged: values above 2147483 s exceed
the idle-timeout property's maximum (G_MAXINT ms) and are rejected with a
warning, and above 4294967 s the product wraps, as before.

Forwarded: no
Last-Update: 2026-10-13
---
 cinnamon-session/csm-manager.c | 57 +++++++++++++++++++++++++++++++++++++++---
 cinnamon-session/csm-manager.h |  1 +
 cinnamon-session/main.c        |  2 ++
 3 files changed, 57 insertions(+), 3 deletions(-)

diff --git a/cinnamon-session/csm-manager.c b/cinnamon-session/csm-manager.c
index bfbc720..019da53 100644
--- a/cinnamon-session/csm-manager.c
+++ b/cinnamon-session/csm-manager.c
@@ -76,6 +76,7 @@
 #define GDM_FLEXISERVER_ARGS    "--startnew Standard"
 
 #define SESSION_SCHEMA            "org.cinnamon.desktop.session"
+#define GNOME_SESSION_SCHEMA      "org.gnome.desktop.session"
 #define KEY_IDLE_DELAY            "idle-delay"
 #define KEY_SESSION_NAME          "session-name"
 
@@ -141,6 +142,7 @@ struct CsmManagerPrivate
 
         GSettings              *settings;
         GSettings              *session_settings;
+        GSettings              *idle_delay_settings;
         GSettings              *power_settings;
         GSettings              *lockdown_settings;
 
@@ -3551,6 +3553,8 @@ csm_manager_dispose (GObject *object)
                 manager->priv->settings = NULL;
         }
 
+        g_clear_object (&manager->priv->idle_delay_settings);
+
         if (manager->priv->session_settings) {
                 g_object_unref (manager->priv->session_settings);
                 manager->priv->session_settings = NULL;
@@ -3709,7 +3713,56 @@ csm_manager_init (CsmManager *manager)
                           G_CALLBACK (on_presence_status_changed),
                           manager);
 
-        g_settings_bind_with_mapping (manager->priv->session_settings,
+        manager->priv->system = csm_get_system ();
+}
+
+static gboolean
+in_unity_session (void)
+{
+        const char *desktops = g_getenv ("XDG_CURRENT_DESKTOP");
+        gchar **names;
+        gboolean found;
+
+        if (desktops == NULL)
+                return FALSE;
+
+        names = g_strsplit (desktops, ":", -1);
+        found = g_strv_contains ((const gchar * const *) names, "Unity");
+        g_strfreev (names);
+
+        return found;
+}
+
+/* The Unity Control Center sets the idle delay in org.gnome.desktop.session;
+ * in a Unity session the presence follows that key, elsewhere Cinnamon's.
+ * Called once, after the session file has set XDG_CURRENT_DESKTOP. */
+void
+csm_manager_bind_idle_delay (CsmManager *manager)
+{
+        GSettings *settings = manager->priv->session_settings;
+
+        if (in_unity_session ()) {
+                GSettingsSchema *schema;
+
+                schema = g_settings_schema_source_lookup (g_settings_schema_source_get_default (),
+                                                          GNOME_SESSION_SCHEMA, TRUE);
+                if (schema != NULL && g_settings_schema_has_key (schema, KEY_IDLE_DELAY)) {
+                        GSettingsSchemaKey *key = g_settings_schema_get_key (schema, KEY_IDLE_DELAY);
+
+                        if (g_variant_type_equal (g_settings_schema_key_get_value_type (key),
+                                                  G_VARIANT_TYPE_UINT32)) {
+                                manager->priv->idle_delay_settings = g_settings_new_full (schema, NULL, NULL);
+                                settings = manager->priv->idle_delay_settings;
+                        }
+                        g_settings_schema_key_unref (key);
+                }
+                if (settings == manager->priv->session_settings)
+                        g_debug ("CsmManager: no usable %s %s, using %s", GNOME_SESSION_SCHEMA,
+                                 KEY_IDLE_DELAY, SESSION_SCHEMA);
+                g_clear_pointer (&schema, g_settings_schema_unref);
+        }
+
+        g_settings_bind_with_mapping (settings,
                                       KEY_IDLE_DELAY,
                                       manager->priv->presence,
                                       "idle-timeout",
@@ -3717,8 +3770,6 @@ csm_manager_init (CsmManager *manager)
                                       idle_timeout_get_mapping,
                                       NULL,
                                       NULL, NULL);
-
-        manager->priv->system = csm_get_system ();
 }
 
 CsmManager *
diff --git a/cinnamon-session/csm-manager.h b/cinnamon-session/csm-manager.h
index 1d688f8..1bd067e 100644
--- a/cinnamon-session/csm-manager.h
+++ b/cinnamon-session/csm-manager.h
@@ -136,6 +136,7 @@ gboolean            csm_manager_add_legacy_session_apps        (CsmManager     *
                                                                 const char     *path);
 
 void                csm_manager_start                          (CsmManager     *manager);
+void                csm_manager_bind_idle_delay                (CsmManager     *manager);
 
 const char *        _csm_manager_get_default_session           (CsmManager     *manager);
 
diff --git a/cinnamon-session/main.c b/cinnamon-session/main.c
index 6b30627..b86d6d2 100644
--- a/cinnamon-session/main.c
+++ b/cinnamon-session/main.c
@@ -142,6 +142,8 @@ on_bus_acquired (GDBusConnection *connection,
         if (!csm_session_fill (manager, session_name)) {
                 csm_util_init_error (TRUE, "Failed to load session \"%s\"", session_name ? session_name : "(null)");
         }
+
+        csm_manager_bind_idle_delay (manager);
 }
 
 static gboolean
