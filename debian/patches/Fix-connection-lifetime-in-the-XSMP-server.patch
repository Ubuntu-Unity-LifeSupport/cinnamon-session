From: NeiroNext <mihail.rozshko@gmail.com>
Date: Tue, 13 Oct 2026 07:05:10 +0000
Subject: Fix connection lifetime in the XSMP server

Every ICE connection of the XSMP server now has one owner that closes
it: the authentication watch or its protocol timeout until the XSMP
client is set up, the CsmXSMPClient after that. The ICE error handler
only logs. When the connection is handed to a CsmXSMPClient, the
authentication watch's data is freed by the watch itself after
IceProcessMessages() returns, and the connection is left to the client.

Assisted-by: LLM Claude Opus 5.5
---
 cinnamon-session/csm-xsmp-server.c | 68 ++++++++++++++++++++++++++++----------
 1 file changed, 51 insertions(+), 17 deletions(-)

diff --git a/cinnamon-session/csm-xsmp-server.c b/cinnamon-session/csm-xsmp-server.c
index 46e535a..b63e540 100644
--- a/cinnamon-session/csm-xsmp-server.c
+++ b/cinnamon-session/csm-xsmp-server.c
@@ -92,8 +92,12 @@ typedef struct {
 } CsmIceConnectionData;
 
 typedef struct {
-        guint watch_id;
-        guint protocol_timeout;
+        guint    watch_id;
+        guint    protocol_timeout;
+        /* Set when accept_xsmp_connection() handed the connection to a
+         * CsmXSMPClient: from then on the client owns the connection and
+         * closes it; this watch only frees itself. */
+        gboolean handed_over;
 } CsmIceConnectionWatch;
 
 static void
@@ -128,6 +132,7 @@ ice_protocol_timeout (IceConn ice_conn)
                  ice_conn, IceConnectionStatus (ice_conn));
 
         data = ice_conn->context;
+        ice_conn->context = NULL;
 
         free_ice_connection_watch (data);
         disconnect_ice_connection (ice_conn);
@@ -141,23 +146,38 @@ auth_iochannel_watch (GIOChannel   *source,
                       IceConn       ice_conn)
 {
 
-        CsmIceConnectionWatch *data;
-        gboolean               keep_going;
+        CsmIceConnectionWatch    *data;
+        IceProcessMessagesStatus  status;
+        gboolean                  keep_going;
 
+        /* Read once, before IceProcessMessages(): after it returns, the
+         * connection may belong to a CsmXSMPClient or may have been freed,
+         * so only this cached pointer is used below. */
         data = ice_conn->context;
 
-        switch (IceProcessMessages (ice_conn, NULL, NULL)) {
+        status = IceProcessMessages (ice_conn, NULL, NULL);
+
+        if (data->handed_over) {
+                /* The sources were removed by accept_xsmp_connection(), and
+                 * the CsmXSMPClient owns the connection now. */
+                g_free (data);
+                return FALSE;
+        }
+
+        switch (status) {
         case IceProcessMessagesSuccess:
                 keep_going = TRUE;
                 break;
         case IceProcessMessagesIOError:
                 g_debug ("CsmXsmpServer: IceProcessMessages returned IceProcessMessagesIOError");
+                ice_conn->context = NULL;
                 free_ice_connection_watch (data);
                 disconnect_ice_connection (ice_conn);
                 keep_going = FALSE;
                 break;
         case IceProcessMessagesConnectionClosed:
                 g_debug ("CsmXsmpServer: IceProcessMessages returned IceProcessMessagesConnectionClosed");
+                /* libICE may have freed the connection: do not touch it. */
                 free_ice_connection_watch (data);
                 keep_going = FALSE;
                 break;
@@ -344,8 +364,28 @@ accept_xsmp_connection (SmsConn        sms_conn,
         ice_conn = SmsGetIceConnection (sms_conn);
         data = ice_conn->context;
 
-        /* Each CsmXSMPClient has its own IceConn watcher */
-        free_ice_connection_watch (data);
+        if (data == NULL) {
+                /* Already handed over to a CsmXSMPClient. */
+                g_debug ("CsmXsmpServer: connection already handed over, rejecting");
+
+                *failure_reason_ret = strdup ("Refusing a second client setup on the same connection\n");
+                return FALSE;
+        }
+
+        /* Each CsmXSMPClient has its own IceConn watcher. This runs inside
+         * the authentication watch's IceProcessMessages(), so the watch
+         * data is not freed here: auth_iochannel_watch() frees it when
+         * that call returns, and leaves the connection to the client. */
+        if (data->watch_id) {
+                g_source_remove (data->watch_id);
+                data->watch_id = 0;
+        }
+        if (data->protocol_timeout) {
+                g_source_remove (data->protocol_timeout);
+                data->protocol_timeout = 0;
+        }
+        data->handed_over = TRUE;
+        ice_conn->context = NULL;
 
         client = csm_xsmp_client_new (ice_conn);
 
@@ -371,16 +411,10 @@ ice_error_handler (IceConn       conn,
                  conn, swap ? "TRUE" : "FALSE", offending_minor_opcode,
                  offending_sequence, error_class, severity);
 
-        if (severity == IceCanContinue) {
-                return;
-        }
-
-        /* FIXME: the ICElib docs are completely vague about what we're
-         * supposed to do in this case. Need to verify that calling
-         * IceCloseConnection() here is guaranteed to cause neither
-         * free-memory-reads nor leaks.
-         */
-        IceCloseConnection (conn);
+        /* Only log. The connection is closed by whoever owns it: the
+         * authentication watch or its protocol timeout until the client
+         * is set up, the CsmXSMPClient after that. Closing it here, inside
+         * IceProcessMessages(), would close it under its owner. */
 }
 
 static void
